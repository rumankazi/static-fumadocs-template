# Path prefix the site is served under.
# GitHub Pages *project* site (https://<user>.github.io/<repo>) -> "/<repo>"
# GitHub Pages *user/org* site or a custom domain              -> leave empty
NEXT_PUBLIC_BASE_PATH=

# Absolute URL of the deployed site, used as `metadataBase` for OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Git host used for the repo link and "Edit this page" links.
# Defaults to https://github.com. Set this for GitHub Enterprise Server.
# Prefer editing `gitConfig.host` in lib/shared.ts; this is for overriding in CI.
# NEXT_PUBLIC_GIT_HOST=https://gh.your-org.com
